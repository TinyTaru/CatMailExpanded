<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CatMailExpanded</AssemblyName>
    <RootNamespace>CatMailExpanded</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)'=='' And '$(OS)'=='Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\CatMailCo</GameDir>
    <GameDir Condition="'$(GameDir)'==''">/Applications/CatMailCo LAN</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
    <NoWarn>CS0618;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MLDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\*.dll" Exclude="$(MLDir)\Il2CppAssemblies\netstandard.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\Build\**\*" LogicalName="CME/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)'!='false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(GameDir)\Mods" />
  </Target>
</Project>
